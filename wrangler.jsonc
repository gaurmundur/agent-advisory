// Cloudflare Workers config. The site is fully static, so this Worker only serves
// the files in ./dist. Static asset requests are free and unlimited on the free plan.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hjalti-vefur",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
