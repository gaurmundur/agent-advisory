---
// Task -> setup pairs: which kind of model, skill or connection fits which kind of work.
interface Props {
  matches: { task: string; kind: string; fit: string }[];
  caption: string;
}

const { matches, caption } = Astro.props;
---

<div class="border-t-2 border-heading">
  {matches.map((match) => (
    <div class="grid grid-cols-[minmax(0,1fr)_28px_minmax(0,1fr)] items-center gap-3 border-b border-line py-[18px]">
      <span class="font-bold text-heading">{match.task}</span>
      <span class="text-center font-extrabold text-accent" aria-hidden="true">
        →
      </span>
      <span class="text-[15px]">
        <b class="block font-mono text-xs font-medium tracking-[0.02em] text-accent uppercase">
          {match.kind}
        </b>
        {match.fit}
      </span>
    </div>
  ))}
</div>
<p class="mt-3 text-[13px] text-muted">{caption}</p>
