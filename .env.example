# Copy this file to .env and fill it in. .env is git-ignored and never uploaded.
# The values come from cPanel -> FTP Accounts (or your main cPanel login).

# Use hjaltiunnar.ams.scw.site, not ftp.hjaltiunnar.ams.scw.site: the server's TLS certificate
# is for *.ams.scw.site, which does not cover the extra "ftp." level.
FTP_HOST=
FTP_USER=
FTP_PASSWORD=

# Folder on the server, relative to the FTP account's home folder (the "Path" column in
# cPanel -> FTP Accounts). Leave empty if that path already ends in public_html.
FTP_REMOTE_DIR=public_html

# Encrypted FTP (FTPS). Set to false only if the host does not support it.
FTP_SECURE=true
